{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betabeeswax.github.io/MCAI-OS-APPS/schema/package.schema.json",
  "title": "MCAI-OS mcai-app-v1 package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "name",
    "version",
    "target",
    "ui"
  ],
  "properties": {
    "format": {
      "const": "mcai-app-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "target": {
      "const": "cardputer-adv"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "initial",
        "increment"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "initial": {
          "type": "integer",
          "minimum": -999999,
          "maximum": 999999
        },
        "increment": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
